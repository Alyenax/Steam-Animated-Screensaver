{
  "name": "steam-animated-screensaver",
  "productName": "Steam Animated Screensaver",
  "version": "0.1.9",
  "description": "Prepare, preview and install animated SteamGridDB artwork as a Steam screensaver.",
  "main": "main.cjs",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "dev": "node scripts/dev-server.cjs",
    "test": "node --test tests/*.test.cjs",
    "check": "node scripts/check.cjs",
    "package:linux": "node scripts/package.cjs linux x64",
    "smoke:electron": "SAS_SMOKE_TEST=1 electron .",
    "package:mac": "node scripts/package.cjs darwin arm64",
    "package:windows": "node scripts/package.cjs win32 x64",
    "package:steamos": "node scripts/package.cjs steamos x64",
    "release:check": "node scripts/release-check.cjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.2",
    "playwright": "1.61.1",
    "prettier": "3.9.10"
  }
}
